---
import { heroSources, PORTRAIT_MEDIA, type HeroVariant } from '../lib/hero';

/** wideOnly = jen široký snímek (bez portrétu pro telefon) – oddálený záběr na konci Příběhu */
interface Props { id?: string; class?: string; alt?: string; priority?: boolean; hidden?: boolean; variant?: HeroVariant; wideOnly?: boolean }
const { id, class: cls, alt, priority = false, hidden = false, variant = 'light', wideOnly = false } = Astro.props;
const src = await heroSources(variant);
const s = wideOnly ? { ...src, tall: null } : src;
// rozměry a poloha stolu pro match cut v Příběhu (story.ts)
const geo = {
  wide: [s.wide.width, s.wide.height, ...s.wide.table].join(','),
  tall: s.tall ? [s.tall.width, s.tall.height, ...s.tall.table].join(',') : undefined,
};
---
<picture>
  {s.tall && <source media={PORTRAIT_MEDIA} type="image/avif" srcset={s.tall.avif} sizes="100vw" />}
  {s.tall && <source media={PORTRAIT_MEDIA} type="image/webp" srcset={s.tall.webp} sizes="100vw" />}
  <source type="image/avif" srcset={s.wide.avif} sizes="100vw" />
  <img
    id={id}
    class={cls}
    src={s.wide.src}
    srcset={s.wide.webp}
    sizes="100vw"
    width={s.wide.width}
    height={s.wide.height}
    alt={hidden ? '' : (alt ?? s.alt)}
    aria-hidden={hidden ? 'true' : undefined}
    fetchpriority={priority ? 'high' : undefined}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? undefined : 'async'}
    data-table-wide={geo.wide}
    data-table-tall={geo.tall}
  />
</picture>
