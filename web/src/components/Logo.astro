---
/**
 * DOČASNÉ: varianty loga v hlavičce (/logo/1/ … /logo/4/), navazují na hero „Monolit“
 * (stejné písmo jako velké SMOLÍK, motiv kvádru). Barvy přes currentColor → fungují na světlé i tmavé hlavičce.
 * 1 Monolit ve jménu · 2 Čistá typografie · 3 Malý monolit (fotka z hero) · 4 Původní logo bez popisku, nápis na střed značky
 */
import { getImage } from 'astro:assets';
import { img } from '../lib/images';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
interface Props { v: '1' | '2' | '3' | '4' }
const { v } = Astro.props;
// malý monolit z hero (varianta 3) a jeho textura pro proužek ve jménu (varianta 1)
const mini = await getImage({ src: img('monolit-mini.webp'), height: 96, densities: [1, 2], format: 'webp' });
const strip = await getImage({ src: img('monolit-strip.webp'), format: 'webp' });
---
{v === '1' && (
  <span class="lg lg1">
    <span class="lg-w">SMO<i class="lg1-bar" style={`background-image:url(${strip.src})`}></i>LÍK</span>
    <span class="lg-d" aria-hidden="true">Kamenictví · Dub nad Moravou</span>
  </span>
)}
{v === '2' && (
  <span class="lg lg2">
    <span class="lg-w">SMOLÍK</span>
    <span class="lg2-rule"></span>
    <span class="lg-d lg2-d" aria-hidden="true">Kamenictví<br />Dub nad Moravou</span>
  </span>
)}
{v === '3' && (
  <span class="lg lg3">
    <img class="lg3-mark" src={mini.src} srcset={mini.srcSet.attribute} width={mini.attributes.width} height={mini.attributes.height} alt="" aria-hidden="true" />
    <span class="lg3-t"><span class="lg-w">SMOLÍK</span><span class="lg-d" aria-hidden="true">Kamenictví · Dub nad Moravou</span></span>
  </span>
)}
{v === '4' && (
  <span class="lg lg4">
    <Mark />
    <Wordmark class="wmk lg4-wmk" />
  </span>
)}
