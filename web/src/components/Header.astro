---
import Mark from './Mark.astro';
import { getImage } from 'astro:assets';
import { img } from '../lib/images';
import { NAV, PHONE, TEL } from '../lib/site';

/**
 * logo: 'mark' = původní značka + SMOLÍK písmem z hero (hlavní stránka),
 *       'monolit' = malý kvádr travertinu z hero + SMOLÍK + popisek (/black)
 */
interface Props { logo?: 'mark' | 'monolit' }
const { logo = 'mark' } = Astro.props;
const mini = logo === 'monolit' ? await getImage({ src: img('monolit-mini.webp'), height: 96, densities: [1, 2], format: 'webp' }) : null;
---
<div class="progress" aria-hidden="true"></div>
<header class="top" id="topbar">
  <a class:list={["logo", { "logo--mark": !mini }]} href="#hero" aria-label="Smolík – Kamenictví · Dub nad Moravou, úvod">
    {mini ? (
      <Fragment>
        <img class="mini" src={mini.src} srcset={mini.srcSet.attribute} width={mini.attributes.width} height={mini.attributes.height} alt="" aria-hidden="true" />
        <span class="wm"><span class="wmt" aria-hidden="true">SMOLÍK</span><span class="desc" aria-hidden="true">Kamenictví · Dub nad Moravou</span></span>
      </Fragment>
    ) : <Fragment><Mark /><span class="wmt" aria-hidden="true">SMOLÍK</span></Fragment>}
  </a>
  <nav class="nav" aria-label="Hlavní navigace">
    {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <div class="top-r">
    <a class="pill" href={TEL} aria-label={`Zavolat ${PHONE}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>{PHONE}</span>
    </a>
    <button class="burger" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="menu"><i></i><i></i></button>
  </div>
</header>
<div class="statusbar" aria-hidden="true"></div>
