---
/** Varianta 2 „Okénko v nadpisu“: malé okénko s fotkou uprostřed nadpisu se scrollem rozevře přes celou obrazovku. */
import HeroPicture from '../HeroPicture.astro';
import HeroCopy from './HeroCopy.astro';
---
<section class="hx hx2" id="hero" aria-label="Úvod">
  <div class="hx-stage">
    <div class="hx2-photo"><HeroPicture id="heroImg" priority /></div>
    <div class="hx-shade" aria-hidden="true"></div>
    <div class="hx2-title" aria-hidden="true">
      <span class="hx2-l hx2-l1"><span class="hx2-w"><span>Z přírody.</span></span></span>
      <span class="hx2-l hx2-l2"><span class="hx2-w hx2-left"><span>Do</span></span><span class="hx2-pill"></span><span class="hx2-w hx2-right"><span>vašeho</span></span></span>
      <span class="hx2-l hx2-l3"><span class="hx2-w"><span>prostoru.</span></span></span>
    </div>
    <div class="hx2-kick" aria-hidden="true"><span>Kamenictví Smolík</span><span class="hx-cue">Scrollujte</span></div>
    <HeroCopy />
  </div>
</section>
