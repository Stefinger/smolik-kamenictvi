---
/** Nadpis, text a tlačítka hero – společné pro varianty hero (slova vyplouvají z rozmazání, viz .is-shown). */
import { PHONE, TEL } from '../../lib/site';

interface Props { class?: string }
const { class: cls } = Astro.props;
const lines = [['Z', 'přírody.'], ['Do', 'vašeho', 'prostoru.']];
let i = 0;
---
<div class:list={['hx-copy', cls]}>
  <h1 class="hx-h1" aria-label="Z přírody. Do vašeho prostoru.">
    {lines.map((l) => (
      <span class="hx-l" aria-hidden="true">{l.map((w, j) => <Fragment>{j > 0 && ' '}<span class="hx-w" style={`--i:${i++}`}>{w}</span></Fragment>)}</span>
    ))}
  </h1>
  <p class="hx-p">Stoly, kuchyňské desky, obklady i fasády. Každý kus z přírodního kamene, na míru místu, kde bude stát.</p>
  <div class="hx-ctas">
    <a class="hx-btn" href={TEL}>Zavolat <em>{PHONE}</em></a>
    <a class="hx-btn hx-btn--ghost" href="#materialy">Vybrat materiál<span aria-hidden="true">→</span></a>
  </div>
</div>
