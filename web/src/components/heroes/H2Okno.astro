---
/** Varianta 2 „Okno do kamene“: písmena SMOLÍK jsou okna do živého černého mramoru, scroll vletí do Í. */
import HxPic from './HxPic.astro';
import HxCtas from './HxCtas.astro';
import { asset } from '../../lib/paths';
---
<section class="hx ho hx-dyn" id="hero" aria-label="Úvod">
  <div class="hx-stage">
    <div class="ho-media">
      <HxPic wide="mramor.webp" id="heroImg" priority alt="Leštěný černý mramor s bílou a zlatou žilkou" />
      <video class="ho-video" muted playsinline loop preload="none" aria-hidden="true" data-src={asset('hx/mramor.mp4')}></video>
    </div>
    <div class="ho-shade" aria-hidden="true"></div>
    <svg class="ho-mask" aria-hidden="true" focusable="false">
      <defs>
        <mask id="hom" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
          <rect x="0" y="0" width="100%" height="100%" fill="#fff" />
          <text text-anchor="middle" dominant-baseline="central" fill="#000">SMOLÍK</text>
        </mask>
      </defs>
      <rect x="0" y="0" width="100%" height="100%" fill="#ece9e1" mask="url(#hom)" />
    </svg>
    <div class="ho-top" aria-hidden="true">Kamenictví<span>·</span>Dub nad Moravou</div>
    <div class="ho-bottom" aria-hidden="true"><span>Kámen, který přetrvá</span><span class="hx-cue">Scrollujte</span></div>
    <div class="ho-copy">
      <h1 class="hx-h1"><span class="hx-l"><span class="hx-w" style="--i:0">Kámen,</span> <span class="hx-w" style="--i:1">který</span></span><span class="hx-l"><span class="hx-w" style="--i:2">přetrvá</span> <span class="hx-w" style="--i:3">generace.</span></span></h1>
      <p class="hx-p">Mramor, žula, břidlice i pískovec. Vybereme s vámi kámen, opracujeme ho v dílně a osadíme na místo.</p>
      <HxCtas tone="dark" />
    </div>
  </div>
</section>
