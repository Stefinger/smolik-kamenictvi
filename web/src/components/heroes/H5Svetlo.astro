---
/** Varianta 5 „Světlo“: kamenná stěna ve tmě, kurzor (na telefonu prst / samo) je reflektor, který ji rozsvítí. */
import HxPic from './HxPic.astro';
import HxCtas from './HxCtas.astro';
---
<section class="hx hs hx--dark" id="hero" aria-label="Úvod">
  <div class="hs-base"><HxPic wide="stena-d.webp" tall="stena-m.webp" id="heroImg" priority alt="Stěna z lámaného tmavého kamene nasvícená teplým světlem" /></div>
  <div class="hs-lit" aria-hidden="true"><HxPic wide="stena-d.webp" tall="stena-m.webp" priority /></div>
  <div class="hs-vignette" aria-hidden="true"></div>
  <div class="hs-copy">
    <p class="hs-kick hx-fade">Kamenictví Smolík · Dub nad Moravou</p>
    <h1 class="hx-h1 hs-h1"><span class="hx-l"><span class="hx-w" style="--i:0">Kámen</span> <span class="hx-w" style="--i:1">ožije</span></span><span class="hx-l"><span class="hx-w" style="--i:2">ve</span> <span class="hx-w" style="--i:3">světle.</span></span></h1>
    <p class="hx-p">Obklady, stěny a schodiště z lámaného kamene. Navrhneme i nasvícení, které vytáhne každou hranu.</p>
    <HxCtas tone="dark" />
  </div>
  <p class="hs-hint hx-fade" aria-hidden="true">Posvěťte si na kámen</p>
</section>
