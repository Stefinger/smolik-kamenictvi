---
/** Varianta 3 „Řez“: fotka rozřezaná na pásy jako kamenné desky; při načtení se pásy zasunou, při scrollu rozestoupí. */
import HeroPicture from '../HeroPicture.astro';
import HeroCopy from './HeroCopy.astro';
const bands = [0, 1, 2, 3, 4, 5, 6];
---
<section class="hx hx3" id="hero" aria-label="Úvod">
  <div class="hx3-bands" aria-hidden="true">
    {bands.map((i) => (
      <div class="hx3-band" style={`--i:${i};--d:${i % 2 ? 1 : -1}`}>
        <HeroPicture id={i === 0 ? 'heroImg' : undefined} priority={i === 0} hidden />
      </div>
    ))}
  </div>
  <div class="hx-shade" aria-hidden="true"></div>
  <div class="hx3-kick" aria-hidden="true">Kamenictví · Dub nad Moravou</div>
  <HeroCopy class="is-auto" />
</section>
