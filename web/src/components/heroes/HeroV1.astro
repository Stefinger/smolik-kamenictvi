---
/** Varianta 1 „Okno ve jméně“: písmena SMOLÍK jsou okna do fotky, scroll „vletí“ do písmene Í až na celou fotku. */
import HeroPicture from '../HeroPicture.astro';
import HeroCopy from './HeroCopy.astro';
---
<section class="hx hx1" id="hero" aria-label="Úvod">
  <div class="hx-stage">
    <div class="hx1-photo"><HeroPicture id="heroImg" priority /></div>
    <div class="hx-shade" aria-hidden="true"></div>
    <svg class="hx1-mask" aria-hidden="true" focusable="false">
      <defs>
        <mask id="hx1m" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
          <rect x="0" y="0" width="100%" height="100%" fill="#fff" />
          <text text-anchor="middle" dominant-baseline="central" fill="#000">SMOLÍK</text>
        </mask>
      </defs>
      <rect x="0" y="0" width="100%" height="100%" fill="#ece9e1" mask="url(#hx1m)" />
    </svg>
    <div class="hx1-top" aria-hidden="true">Kamenictví · Dub nad Moravou</div>
    <div class="hx1-bottom" aria-hidden="true"><span>Přírodní kámen na míru</span><span class="hx-cue">Scrollujte</span></div>
    <HeroCopy />
  </div>
</section>
