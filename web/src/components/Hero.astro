---
/**
 * Hero „Monolit“: osamělý kvádr travertinu jako socha v galerii, jméno SMO | LÍK kolem něj.
 * Text vlevo, vpravo jediné tlačítko „Vybrat materiál“ (telefon je v hlavičce).
 * Nástup: kámen vyjede, písmena se zaostří, nadpis vyjede po slovech (jako dřív). Scroll: kámen povyroste,
 * jméno se rozestoupí (monolit.ts). Rozvržení pro každý poměr stran viz hero-monolit.css.
 */
import { monolitSources, MONOLIT_SIZES } from '../lib/hero';

const s = await monolitSources();
// nadpis vyjede celý najednou spolu s hlavičkou, textem a tlačítkem – až po kameni a jménu SMOLÍK
const line1 = [['Z', '1.4s'], ['přírody.', '1.4s']];
const line2 = [['Do', '1.4s'], ['vašeho', '1.4s'], ['prostoru.', '1.4s']];
---
<section class="hm" id="hero" aria-label="Úvod" style={`--ar:${(s.width / s.height).toFixed(4)}`}>
  <div class="hm-stage">
    <div class="hm-area">
      <div class="hm-word" aria-hidden="true"><span class="hm-a"><i>SMO</i></span><span class="hm-b"><i>LÍK</i></span></div>
      <div class="hm-stone">
        <div class="hm-in">
          <span class="hm-shadow" aria-hidden="true"></span>
          <picture>
            <source type="image/avif" srcset={s.avif} sizes={MONOLIT_SIZES} />
            <img id="heroImg" src={s.src} srcset={s.webp} sizes={MONOLIT_SIZES} width={s.width} height={s.height}
              alt="Monolit z travertinu se štípanými hranami" fetchpriority="high" loading="eager" />
          </picture>
        </div>
      </div>
    </div>
    <div class="hm-copy">
      <div class="hm-text">
        <h1 aria-label="Z přírody. Do vašeho prostoru.">
          <span class="l" aria-hidden="true">{line1.map(([w, d], i) => <Fragment>{i > 0 && ' '}<span class="w"><span style={`--d:${d}`}>{w}</span></span></Fragment>)}</span>
          <span class="l" aria-hidden="true">{line2.map(([w, d], i) => <Fragment>{i > 0 && ' '}<span class="w"><span style={`--d:${d}`}>{w}</span></span></Fragment>)}</span>
        </h1>
        <p class="hm-p">Stoly, kuchyňské desky, obklady i fasády. Každý kus z přírodního kamene, na míru místu, kde bude stát.</p>
      </div>
      <!-- volání je v hlavičce (a na telefonu v plovoucí liště pod hero), tady jen výběr materiálu -->
      <a class="btn ghost hm-cta" href="#materialy">Vybrat materiál<span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero';
  import { initMonolit } from '../scripts/monolit';
  initHero();
  initMonolit();
</script>
