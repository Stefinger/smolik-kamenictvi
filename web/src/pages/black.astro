---
/**
 * Varianta pro porovnání: stejná stránka jako hlavní, ale Příběh v původním tmavém ateliéru
 * (krok 6 = světlý hotový stůl) a v hlavičce malý kvádr travertinu. Neindexuje se, kanonická adresa je „/“.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import CallBar from '../components/CallBar.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Story from '../components/Story.astro';
import Works from '../components/Works.astro';
import Materials from '../components/Materials.astro';
import Footer from '../components/Footer.astro';
import { monolitSources, MONOLIT_SIZES } from '../lib/hero';

const stone = await monolitSources();
---
<Base preloadHero={false} alternate>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={stone.avif} imagesizes={MONOLIT_SIZES} fetchpriority="high" />
  <Header logo="monolit" />
  <Menu />
  <CallBar />
  <main id="top">
    <Hero />
    <Process />
    <Story variant="dark" finale="light" />
    <Works />
    <Materials />
    <Footer />
  </main>
  <script>
    import { initNav } from '../scripts/nav';
    import { initReveal } from '../scripts/reveal';
    import { initPreload } from '../scripts/preload';
    import { initParallax } from '../scripts/parallax';
    initNav();
    initReveal();
    initPreload();
    initParallax();
  </script>
</Base>
