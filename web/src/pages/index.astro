---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import CallBar from '../components/CallBar.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Story from '../components/Story.astro';
import Works from '../components/Works.astro';
import Materials from '../components/Materials.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <Menu />
  <CallBar />
  <main id="top">
    <Hero />
    <Process />
    <Story />
    <Works />
    <Materials />
    <Footer />
  </main>
  <script>
    import { initNav } from '../scripts/nav';
    import { initReveal } from '../scripts/reveal';
    import { initPreload } from '../scripts/preload';
    import { initParallax } from '../scripts/parallax'; // DOČASNÉ – varianta 1
    initNav();
    initReveal();
    initPreload();
    initParallax();
  </script>
</Base>
