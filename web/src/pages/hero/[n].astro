---
/**
 * DOČASNÉ: 5 variant hero k výběru (/hero/1/ … /hero/5/). Zbytek stránky je stejný jako hlavní.
 * Neindexuje se, kanonická adresa je „/“. Po výběru se vybraná varianta přesune na hlavní stránku a tohle se smaže.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Menu from '../../components/Menu.astro';
import CallBar from '../../components/CallBar.astro';
import H1Monolit from '../../components/heroes/H1Monolit.astro';
import H2Okno from '../../components/heroes/H2Okno.astro';
import H3Lom from '../../components/heroes/H3Lom.astro';
import H4Vzornik from '../../components/heroes/H4Vzornik.astro';
import H5Svetlo from '../../components/heroes/H5Svetlo.astro';
import Process from '../../components/Process.astro';
import Story from '../../components/Story.astro';
import Works from '../../components/Works.astro';
import Materials from '../../components/Materials.astro';
import Footer from '../../components/Footer.astro';
import { hxSources, PORTRAIT_MEDIA, LANDSCAPE_MEDIA } from '../../lib/hx';
import '../../styles/hero-variants.css';

export function getStaticPaths() {
  return ['1', '2', '3', '4', '5'].map((n) => ({ params: { n } }));
}
const { n } = Astro.params;
// přednačíst hlavní obrázek varianty (stejné parametry jako v komponentě → stejné URL)
const pre = {
  '1': { s: await hxSources('monolit-m-kamen.webp', undefined, [240, 360, 549]), sizes: '(orientation: portrait) 40vw, 28vh' },
  '2': { s: await hxSources('mramor.webp'), sizes: '100vw' },
  '3': { s: await hxSources('lom-d.webp', 'lom-m.webp'), sizes: '100vw' },
  '4': { s: await hxSources('vz-mramor.webp', undefined, [480, 800, 1200]), sizes: '(orientation: portrait) 100vw, 40vw' },
  '5': { s: await hxSources('stena-d.webp', 'stena-m.webp'), sizes: '100vw' },
}[n!]!;
---
<Base variant={n === '5' ? 'dark' : 'light'} alternate preloadHero={false} callbar="always">
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={pre.s.wide.avif} imagesizes={pre.sizes} media={pre.s.tall ? LANDSCAPE_MEDIA : undefined} fetchpriority="high" />
    {pre.s.tall && <link rel="preload" as="image" type="image/avif" imagesrcset={pre.s.tall.avif} imagesizes={pre.sizes} media={PORTRAIT_MEDIA} fetchpriority="high" />}
  </Fragment>
  <Header />
  <Menu />
  <CallBar />
  <main id="top" data-hx={n}>
    {n === '1' && <H1Monolit />}
    {n === '2' && <H2Okno />}
    {n === '3' && <H3Lom />}
    {n === '4' && <H4Vzornik />}
    {n === '5' && <H5Svetlo />}
    <Process />
    <Story />
    <Works />
    <Materials />
    <Footer />
  </main>
  <script>
    import { initNav } from '../../scripts/nav';
    import { initReveal } from '../../scripts/reveal';
    import { initPreload } from '../../scripts/preload';
    import { initParallax } from '../../scripts/parallax';
    import { initHero } from '../../scripts/hero';
    import { initH1, initH2, initH3, initH4, initH5 } from '../../scripts/hero-variants';
    initNav();
    initReveal();
    initPreload();
    initParallax();
    initHero();
    const inits: Record<string, () => void> = { '1': initH1, '2': initH2, '3': initH3, '4': initH4, '5': initH5 };
    inits[document.querySelector('main')?.dataset.hx ?? '']?.();
  </script>
</Base>
